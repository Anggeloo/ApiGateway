{
  "Routes": [
    // Services Product Search
    {
      "DownstreamPathTemplate": "/products/byCodiceProducto?codice={codice}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_search",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/products/byCodiceProducto?codice={codice}",
      "UpstreamHttpMethod": [ "GET" ],
      "Priority": 0
    },
    {
      "DownstreamPathTemplate": "/products/search?search={search}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_search",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/products/search?search={search}",
      "UpstreamHttpMethod": [ "GET" ],
      "Priority": 1
    },
    {
      "DownstreamPathTemplate": "/products",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_search",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/products",
      "UpstreamHttpMethod": [ "GET" ],
      "Priority": 2
    },
    {
      "DownstreamPathTemplate": "/swagger.json",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_search",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/products/swagger.json",
      "UpstreamHttpMethod": [ "GET" ]
    },
    // Services Product ADD
    {
      "DownstreamPathTemplate": "/products/add",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_add",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/products/add",
      "UpstreamHttpMethod": [ "POST" ],
      "Priority": 3
    },
    {
      "DownstreamPathTemplate": "/swagger.json",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_add",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/productsAdd/swagger.json",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    // Services Product UPDATE
    {
      "DownstreamPathTemplate": "/products/update/{codice}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_update",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/products/update/{codice}",
      "UpstreamHttpMethod": [ "PUT" ],
      "Priority": 4
    },
    {
      "DownstreamPathTemplate": "/swagger.json",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_update",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/productsUpdate/swagger.json",
      "UpstreamHttpMethod": [ "GET", "PUT" ]
    },
    // Services Product DELETE
    {
      "DownstreamPathTemplate": "/products/delete/{codice}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_delete",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/products/delete/{codice}",
      "UpstreamHttpMethod": [ "DELETE" ],
      "Priority": 5
    },
    {
      "DownstreamPathTemplate": "/swagger.json",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_producto_delete",
          "Port": 3000
        }
      ],
      "UpstreamPathTemplate": "/productsDelete/swagger.json",
      "UpstreamHttpMethod": [ "GET", "DELETE" ],
      "Priority": 6
    },
    // Services Inventory Search
    {
      "DownstreamPathTemplate": "/inventory/searchInventoryByCodice/search?codice={search}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_inventario_list",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/inventory/searchInventoryByCodice/search?codice={search}",
      "UpstreamHttpMethod": [ "GET" ],
      "Priority": 7
    },
    {
      "DownstreamPathTemplate": "/inventory",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_inventario_list",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/inventory",
      "UpstreamHttpMethod": [ "GET" ],
      "Priority": 8
    },
    {
      "DownstreamPathTemplate": "/api-docs",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "app_inventario_list",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/inventory/api-docs",
      "UpstreamHttpMethod": [ "GET" ],
      "Priority": 9
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5050"
  }
}